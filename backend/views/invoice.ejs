         <div class="content-body default-height" style=" margin-left: -0.007rem;">
            <div class="container-fluid">
				<div class="card-header page-titles">
					<ol class="breadcrumb">
						<li class="breadcrumb-item"><a href="javascript:void(0)">Shop</a></li>
						<li class="breadcrumb-item active"><a href="javascript:void(0)">Invoice</a></li>
					</ol>

                    <button class="float-end btn btn-primary" id="download-pdf">Download Invoice as PDF</button>
                </div>
                <div class="row">
                    <div class="col-lg-12b">
                        <div class="card mt-3 invoice">
                            <div class="card-header"> Invoice <strong><%= currentDate %></strong> <span class="float-end">
                                    <strong>Status:</strong> <a href="/product-order">Complete</a></span> </div>
                            <div class="card-body">
                                <div class="row mb-5">
                                    <div class="mt-4 col-xl-3 col-lg-3 col-md-6 col-sm-12">
                                        <h6>From:</h6>
                                        <div> <strong>Kip Fit</strong> </div>
                                        <div>Moi AVanue</div>
                                        <div>71-101 Nairobi, Kenya</div>
                                        <div>Email: kipfit-email@webz.com.pl</div>
                                        <div>Phone: +254 712345678</div>
                                    </div>
                                    <div class="mt-4 col-xl-3 col-lg-3 col-md-6 col-sm-12">
                                        <h6>To:</h6>
                                        <div><strong><%= userDetails.first_name %> <%= userDetails.last_name %></strong></div>
                                        <div>Attn: <%= userDetails.address %> <%= userDetails.address2 %></div>
                                        <div><%= userDetails.zip %> <%= userDetails.state %>, <%= userDetails.country %></div>
                                        <div>Email: <%= userDetails.email %></div>
                                        <div>Phone: +254 7........</div>
                                    </div>
                            
                                    <div class="mt-4 col-xl-6 col-lg-6 col-md-12 col-sm-12 d-flex justify-content-lg-end justify-content-md-center justify-content-xs-start">
                                        <div class="row align-items-center">
											<div class="col-sm-9"> 
												<div class="brand-logo mb-3">
													<img class="logo-abbr me-2" width="50" src="images/logo-kipfit.png" alt="">
													<img class="logo-compact" width="110" src="images/logo-text (2).png" alt="">
												</div>
                                                <span>The exact amount: <strong class="d-block"><%= total %> KES</strong>
                                                    <small class="text-muted">Current exchange rate 1 USD = <%= exchangeRate %> KES</small>
                                                </div>
                                            <div class="col-sm-3 mt-3"><img src="<%= qrCodeDataUrl %>" alt="QR Code" class="img-fluid width110"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th class="center">#</th>
                                                <th>Item</th>
                                                <th>Description</th>
                                                <th class="right">Unit Cost</th>
                                                <th class="center">Qty</th>
                                                <th class="right">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% completedOrders.forEach(order => { %>
                                                <% order.items.forEach((item, index) => { %>
                                                    <tr>
                                                        <td class="center"><%= index + 1 %></td>
                                                        <td class="left strong"><%= item.title %></td>
                                                        <td class="left">Item Description</td>
                                                        <td class="right">KES <%= item.price %></td>
                                                        <td class="center"><%= item.quantity %></td>
                                                        <td class="right">KES <%= item.total %></td>
                                                    </tr>
                                                <% }); %>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="row">
                                    <div class="col-lg-4 col-sm-5"> </div>
                                    <div class="col-lg-4 col-sm-5 ms-auto">
                                        <table class="table table-clear">
                                            <tbody>
                                                <tr>
                                                    <td class="left"><strong class="text-black">Subtotal</strong></td>
                                                    <td class="right"> KES <%= subtotal %></td>
                                                </tr>
                                                <tr>
                                                    <td class="left"><strong class="text-black">Discount (20%)</strong></td>
                                                    <td class="right">KES <%= discount %></td>
                                                </tr>
                                                <tr>
                                                    <td class="left"><strong class="text-black">VAT (10%)</strong></td>
                                                    <td class="right">KES <%= vat %></td>
                                                </tr>
                                                <tr>
                                                    <td class="left"><strong class="text-black">Total</strong></td>
                                                    <td class="right"><strong class="text-black">KES <%= total %></strong></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
            </div>
        </div>
