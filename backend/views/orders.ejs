    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        async function updateOrderStatus(orderId, status) {
            try {
                const response = await fetch(`/orders/${orderId}/status`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ status }),
                });
                const result = await response.json();
                if (result.success) {
                    const statusCell = document.getElementById(`status-cell-${orderId}`);
                    statusCell.innerHTML = `
                        <span class="badge badge-${status === 'Completed' ? 'success' : status === 'Processing' ? 'primary' : status === 'On Hold' ? 'secondary' : 'warning'} badge-sm light">
                            ${status}<span class="ms-1 fa ${status === 'Completed' ? 'fa-check' : status === 'Processing' ? 'fa-redo' : status === 'On Hold' ? 'fa-ban' : 'fas fa-stream'}"></span>
                        </span>
                    `;
                } else {
                    alert(result.message);
                }
            } catch (error) {
                console.error('Error updating order status:', error);
            }
        }
    
        async function deleteOrder(orderId) {
            try {
                // Show SweetAlert confirmation dialog
                const confirmDelete = await Swal.fire({
                    title: 'Are you sure?',
                    text: `You are about to delete order #${orderId}`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Delete',
                    cancelButtonText: 'Cancel'
                });
    
                // If the user confirms deletion, proceed with the request
                if (confirmDelete.isConfirmed) {
                    const response = await fetch(`/orders/${orderId}`, {
                        method: 'DELETE',
                    });
                    const result = await response.json();
                    if (result.success) {
                        // Remove the corresponding table row
                        const orderRow = document.getElementById(`order-row-${orderId}`);
                        orderRow.remove();
                        // Show success message
                        Swal.fire('Deleted!', `Order #${orderId} has been deleted.`, 'success');
                    } else {
                        alert(result.message);
                    }
                }
            } catch (error) {
                console.error('Error deleting order:', error);
            }
        }
    </script>
    
