                                                        <a href="#">
                                                            <strong class="text-primary">#<%= order.order_id %></strong></a> by <strong class="text-primary"><%= order.first_name %> <%= order.last_name %></strong><br><a href="mailto:<%= order.email %>"><%= order.email %></a></td>
                                                    <td class="py-2"><%= new Date(order.created_at).toLocaleDateString() %></td>
                                                    <td class="py-2"><%= order.address %>, <%= order.address2 %>, <%= order.country %>, <%= order.state %> <%= order.zip %></td>
                                                    <td class="py-2 text-end" id="status-cell-<%= order.order_id %>">
